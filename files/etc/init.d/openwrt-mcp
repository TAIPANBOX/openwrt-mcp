#!/bin/sh /etc/rc.common
# openwrt-mcp under procd, in two parts (docs/privilege-split.md).
#
# helper   `openwrt-mcp helper`, root. It holds every decision (tokens, policies, the owner's rules,
#          the second factor, held changes, the audit log) and every action (uci, ubus, apk, exec),
#          and it does not listen on the network: it serves one Unix socket,
#          /var/run/openwrt-mcp/helper.sock, root:openwrt-mcp 0660 in a 0750 directory, and answers
#          only a peer whose kernel-reported uid is the listener's.
# serve    `openwrt-mcp serve`, the listener, as the account openwrt-mcp. It parses HTTP and MCP on
#          127.0.0.1 and forwards each bearer token and each typed call to the helper. It holds no
#          capability (all five lists of its file are empty), may start no program (its filter kills
#          execve), has no ubus ACL, and reads no file of the daemon's state. It also serves the pipe
#          the router's own bot reaches Telegram through: for each connection from root it dials
#          api.telegram.org:443 and copies bytes it has no key for (the TLS is the helper's).
#
# Both get no_new_privs, and procd applies each capability file only through ujail, so each has a
# bare jail line: procd then runs `ujail [-U openwrt-mcp -G openwrt-mcp] -C <file> -c -- ...`, which
# drops capabilities, switches the account and builds no jail (measured on OpenWrt 25.12.5: the same
# mount and pid namespaces as init; the listener showed Uid 32768, CapBnd, CapEff and CapPrm 0).
# Each part installs its own seccomp filter (seccomp/denied.txt) first thing, and refuses to run
# unless /proc/self/status shows what is expected (seccomp_filter.go), so a router where ujail is
# missing or procd did not apply a file does not run it.
#
# The helper keeps the nine capabilities of /etc/capabilities/openwrt-mcp.json and no jail: it commits
# /etc/config, starts uci, ubus and apk, and runs exec, which is a root shell under the owner's grant
# and second factor by design; a jail would take the router's view from every program exec starts.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/openwrt-mcp
ACCOUNT=openwrt-mcp

# The listener's account: made once, kept by sysupgrade with /etc/passwd and /etc/group, made again
# here if it is missing. It has no password, no shell and no home of its own.
ensure_account() {
	user_exists "$ACCOUNT" && group_exists "$ACCOUNT" && return 0
	local gid
	gid=$(group_add_next "$ACCOUNT") || return 1
	user_exists "$ACCOUNT" || user_add "$ACCOUNT" "" "$gid" "$ACCOUNT" /var/run/openwrt-mcp /bin/false
}

# The listener's pipe to Telegram, for the router's own bot (docs/approval-path.md): a directory of the
# listener's own, 0700, where it serves the socket the helper reaches as root. /var/run is RAM, so it is
# made at every start.
RELAY_DIR=/var/run/openwrt-mcp-relay

ensure_relay_dir() {
	mkdir -p "$RELAY_DIR" && chown "$ACCOUNT:$ACCOUNT" "$RELAY_DIR" && chmod 0700 "$RELAY_DIR"
}

start_service() {
	ensure_account || { echo "openwrt-mcp: cannot make the account $ACCOUNT" >&2; return 1; }
	ensure_relay_dir || { echo "openwrt-mcp: cannot make $RELAY_DIR" >&2; return 1; }

	procd_open_instance helper
	procd_set_param command "$PROG" helper
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# ujail hands the process an environment of one variable; the programs the helper starts look
	# for uci, ubus and apk on PATH.
	procd_set_param env PATH=/usr/sbin:/usr/bin:/sbin:/bin
	procd_set_param no_new_privs 1
	procd_set_param capabilities /etc/capabilities/openwrt-mcp.json
	procd_add_jail openwrt-mcp
	procd_close_instance

	procd_open_instance serve
	procd_set_param command "$PROG" serve
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user "$ACCOUNT"
	procd_set_param group "$ACCOUNT"
	procd_set_param no_new_privs 1
	procd_set_param capabilities /etc/capabilities/openwrt-mcp-serve.json
	procd_add_jail openwrt-mcp-serve
	procd_close_instance
}

reload_service() {
	# Policies and tokens are re-read from disk on change, so a reload is only
	# needed to pick up a changed listen address.
	restart
}
